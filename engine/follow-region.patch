+/* Capture app extension: a private, atomically replaced state file supplies a
+ * tracked crop in physical monitor coordinates. Missing/stale state draws black. */
+static void capture_follow_update(gsr_capture_kms *self, gsr_color_conversion *color_conversion) {
+    const char *path = getenv("CAPTURE_FOLLOW_STATE");
+    if(!path || !path[0]) return;
+    int valid = 0, x = 0, y = 0, w = 0, h = 0;
+    double updated = 0.0;
+    FILE *file = fopen(path, "r");
+    int fields = file ? fscanf(file, "%d %lf %d %d %d %d", &valid, &updated, &x, &y, &w, &h) : 0;
+    if(file) fclose(file);
+    struct timeval now;
+    gettimeofday(&now, NULL);
+    double age = now.tv_sec + now.tv_usec / 1000000.0 - updated;
+    self->capture_follow_hidden = fields != 6 || valid != 1 || !isfinite(updated) || age > 0.75 || age < -2.0
+        || x < 0 || y < 0 || w < 32 || h < 32 || x > 32768 || y > 32768 || w > 16384 || h > 16384;
+    if(self->capture_follow_hidden) {
+        color_conversion->schedule_clear = true;
+        return;
+    }
+    if(self->params.region_size.x != w || self->params.region_size.y != h)
+        color_conversion->schedule_clear = true;
+    self->params.region_position = (vec2i){x, y};
+    self->params.region_size = (vec2i){w, h};
+}
