{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-vidcapture",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "my-vidcapture", "database_id": "REPLACE_WITH_YOUR_D1_ID", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "VIDEOS", "bucket_name": "my-vidcapture-videos"}],
  "vars": {"SITE_ORIGIN": "https://my-vidcapture.YOUR-SUBDOMAIN.workers.dev"},
  "triggers": {"crons": ["15 4 * * *"]}
}
