{
  "manifest_version": 3,
  "name": "VidCapture",
  "version": "0.1.0",
  "description": "Record on your computer with VidCapture, and turn pasted VidCapture links into video previews in Gmail.",
  "key": "",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {"default_title": "VidCapture", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://vidcapture.stream/*"],
  "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["gmail.js"], "run_at": "document_idle"}]
}
